{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["https://books.toscrape.com/"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Dry run (no LLM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["https://books.toscrape.com/", "--dry-run"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
